{
    "name": "inphinit/proxy",
    "description": "Library for creating a web proxy with CORS",
    "keywords": [ "proxy", "cors", "html2canvas" ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Guilherme Nascimento",
            "email": "brcontainer@yahoo.com.br"
        }
    ],
    "require": {
        "php": ">=5.4.0"
    },
    "autoload": {
        "psr-4": {
            "Inphinit\\Proxy\\": "src/"
        }
    },
    "suggest": {
        "ext-curl": "Needed to support CurlDriver class",
        "ext-openssl": "Needed to support HTTPS urls"
    }
}
